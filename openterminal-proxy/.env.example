# ---------------------------------------------------------------------------
# openterminal-proxy -- copy to .env next to docker-compose.openterminal.yml
# ---------------------------------------------------------------------------

# The key Open WebUI sends as its bearer token. Generate one, do not invent one:
#   openssl rand -base64 36
OTPROXY_API_KEY=

# Separate key for /api/v1/status, /api/v1/terminals and /metrics.
# Leave empty to keep the admin API switched off entirely.
OTPROXY_ADMIN_KEY=

# The group that owns /var/run/docker.sock on the host, so the proxy container
# can reach the daemon without running as root:
#   stat -c '%g' /var/run/docker.sock
DOCKER_GID=999

# --- the sandbox image ------------------------------------------------------
# The full image (~4 GB) carries python, numpy/pandas/scipy, gcc and the rest,
# which is what makes it useful for computing. The slim image is ~430 MB and
# brings almost none of it -- see the README for the capability settings it needs.
OTPROXY_IMAGE=ghcr.io/open-webui/open-terminal:latest

# --- how much one user may use ---------------------------------------------
OTPROXY_MEMORY=2g
OTPROXY_CPUS=1.0
OTPROXY_PIDS_LIMIT=512
OTPROXY_TMPFS_SIZE=512m

# --- how many at once, and for how long ------------------------------------
OTPROXY_MAX_SANDBOXES=50
OTPROXY_POOL_SIZE=1
OTPROXY_IDLE_TIMEOUT=900
OTPROXY_MAX_LIFETIME=86400

# --- networking -------------------------------------------------------------
# One internal /29 per user is carved out of this range. It must not overlap
# anything the host routes, and it is the range the host firewall rule covers.
OTPROXY_NET_SUPERNET=10.88.0.0/16

# --- keep the home directory between sessions (off = nothing survives) ------
OTPROXY_PERSIST_HOME=false
