# Copy to .env and fill in.  docker compose reads this file automatically.

# --- PBX / SIP account the agent registers as -------------------------
SIP_USERNAME=900
SIP_PASSWORD=change-me
SIP_SERVER_HOST=192.168.1.10
# Only needed if the SIP domain differs from the server address:
#SIP_DOMAIN=pbx.local
SIP_SERVER_PORT=5060
# Set only if the container picks the wrong local IP for SDP/Contact:
#SIP_ADVERTISE_HOST=192.168.1.50

# --- Where the agent sends calls it cannot handle (required) ----------
TRANSFER_NUMBER=200

# --- Models -----------------------------------------------------------
OLLAMA_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:7b-instruct-q4_K_M

# piper = lowest latency (CPU, robotic)
# chatterbox = natural voice (~3 GB VRAM, slower first audio)
TTS_BACKEND=piper

# Pin the reserved L4 (nvidia-smi -L shows the UUID):
#GPU_UUID=GPU-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
