# Copy to .env and fill in.  docker compose reads this file automatically.

# --- PBX / SIP account the agent registers as -------------------------
SIP_USERNAME=900
SIP_PASSWORD=change-me
SIP_SERVER_HOST=192.168.1.10
# Only needed if the SIP domain differs from the server address:
#SIP_DOMAIN=pbx.local
SIP_SERVER_PORT=5060

# Where the agent itself listens. Only change it if something else owns 5060 on
# this host -- a local Asterisk in front of the agent is the usual reason.
#SIP_BIND_PORT=5080
# The agent's RTP ports. Asterisk defaults to 10000-20000, so when both run on
# the same machine one of the two ranges has to move or calls come up silent.
#RTP_PORT_START=16000
#RTP_PORT_END=16200

# ---------------------------------------------------------------------------
# Local Asterisk in front of the agent (optional).
#
# Uncomment the COMPOSE_FILE line and plain `docker compose up -d` brings it up
# with the agent -- no longer command to remember. See the README section
# "Eigener Asterisk davor".
#
# The split of roles:
#   PROVIDER_*   the managed PBX and the number IT issued for this Asterisk
#   SIP_*        the agent, now an extension on the LOCAL Asterisk
#
# Those two must be different accounts. One set of credentials is one device:
# if both register as the same extension, the PBX drops one of them.
# ---------------------------------------------------------------------------
#COMPOSE_FILE=docker-compose.yml:docker-compose.asterisk.yml

#PROVIDER_HOST=172.16.0.188       # defaults to SIP_SERVER_HOST
#PROVIDER_PORT=5060
#PROVIDER_USER=1250               # the NEW number, not the agent's
#PROVIDER_PASSWORD=change-me

# Ring the agent this long before falling back to TRANSFER_NUMBER. Keep it
# above the agent's warmup, or a restarting container sends callers to the
# fallback instead of answering.
#AGENT_RING_SECONDS=20

# Asterisk's RTP range. Must not overlap RTP_PORT_START/END above.
#ASTERISK_RTP_START=10000
#ASTERISK_RTP_END=15999
# Set only if the container picks the wrong local IP for SDP/Contact:
#SIP_ADVERTISE_HOST=192.168.1.50

# --- Where the agent sends calls it cannot handle (required) ----------
TRANSFER_NUMBER=200

# How to transfer:
#   auto   try SIP REFER, fall back to the PBX feature code  (recommended)
#   refer  REFER only
#   dtmf   feature code only -- for a managed PBX with allow_transfer=no
TRANSFER_METHOD=auto
# Asterisk blindxfer sequence from features.conf. Vanilla Asterisk often #1,
# FreePBX often ##. Ask your provider which one is set.
TRANSFER_FEATURE_CODE=##

# --- Models -----------------------------------------------------------
OLLAMA_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:7b-instruct-q4_K_M

# Voice:
#   piper      CPU, instant, robotic. Always works -- start here.
#   chatterbox GPU (~3 GB), natural, needs TTS_PROFILE=quality at build time.
TTS_BACKEND=piper

# Build profile:
#   lite     Piper only. Builds in minutes.
#   quality  Also installs Chatterbox and GPU synthesis (~5 GB more, ~15 min).
TTS_PROFILE=lite

# --- Qwen3-TTS: the best German voice, as its own container -------------
# Start it with:
#   docker compose -f docker-compose.yml -f docker-compose.qwen.yml up -d --build
# and set tts.backend: openai in config/config.yaml (or use the
# quality-qwen.yaml profile, which already does).
QWEN_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
# The accepted value differs between builds; startup tries alternatives and logs
# which one worked.
QWEN_LANGUAGE=German
# custom = built-in speaker | clone = your own voice | design = describe it
QWEN_MODE=custom
# Speaker name; the roster is at http://127.0.0.1:8880/voices once running
QWEN_SPEAKER=
# For QWEN_MODE=clone -- put the recording in ./voices (mounted at /voices)
#QWEN_REF_AUDIO=/voices/meine-stimme.wav
#QWEN_REF_TEXT=Guten Tag, Sie sprechen mit dem Service der Beispiel GmbH.
# For QWEN_MODE=design
#QWEN_INSTRUCT=ruhige, freundliche Frauenstimme, mittleres Tempo

# Which GPU the container may use: index (0,1,2...) or UUID from nvidia-smi -L.
# On a multi-GPU host this is required -- otherwise the container may pick a card
# that is already occupied.
GPU_ID=0
